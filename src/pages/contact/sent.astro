---
import TileMark from "../../components/TileMark.astro";
import Layout from "../../layouts/Layout.astro";
---
<Layout title="Message sent" hl="lagoon" noindex>
  <TileMark class="sent-mark" />
  <h1>Thanks, I've got it.</h1>
  <p class="lede">I'll write back to the email you gave.</p>
  <p>While you wait, see what I've built or read how I work.</p>
  <div class="actions">
    <a class="btn primary" href="/projects">Look at the work</a>
    <a class="btn" href="/about">How we'd work together</a>
  </div>
</Layout>
