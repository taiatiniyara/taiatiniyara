---
import { env } from "cloudflare:workers";
import Layout from "../../layouts/Layout.astro";
import PostView from "../../components/PostView.astro";
import { getBody, getPostBySlug, listPosts } from "../../lib/db.ts";
import { firstImage } from "../../lib/content.ts";
import { articleLd, postNeighbours } from "../../lib/posts.ts";

const post = await getPostBySlug(env.DB, null, Astro.params.slug!);
if (!post) return Astro.rewrite("/404");
const [doc, all] = await Promise.all([getBody(env.BUCKET, "posts", post.id), listPosts(env.DB)]);
const image = firstImage(doc);
---
<Layout title={post.title} description={post.summary || undefined} image={image} jsonld={[articleLd(post, Astro.url.href, image)]} hl="sun" article>
  <PostView post={post} doc={doc} trail={postNeighbours(all, post)} />
</Layout>
