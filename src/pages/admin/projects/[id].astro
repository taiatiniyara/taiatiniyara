---
import { env } from "cloudflare:workers";
import AdminLayout from "../../../layouts/AdminLayout.astro";
import EditorShell from "../../../components/EditorShell.astro";
import { getBody, getProject } from "../../../lib/db.ts";
import { emptyDoc } from "../../../lib/content.ts";

const isNew = Astro.params.id === "new";
const project = isNew ? null : await getProject(env.DB, Number(Astro.params.id));
if (!isNew && !project) return Astro.rewrite("/404");
const body = project ? await getBody(env.BUCKET, "projects", project.id) : emptyDoc;
const locked = !!project?.published_at;
---
<AdminLayout title={project ? project.title : "New project"}>
  <h1>{project ? "Edit project" : "New project"}</h1>
  <EditorShell kind="project" id={project?.id} updated={project?.updated_at} body={body} previewHref={project ? `/admin/preview/projects/${project.id}` : undefined}>
    <label for="title">Title</label>
    <input id="title" name="title" type="text" required maxlength="120" value={project?.title ?? ""} />

    <label for="slug">Slug</label>
    <input id="slug" name="slug" type="text" maxlength="80" value={project?.slug ?? ""} readonly={locked} />
    <p class="field-note">{locked ? "Locked because this has been published." : "Leave empty to build it from the title. It locks on first publish."}</p>

    <label for="summary">Summary</label>
    <textarea id="summary" name="summary" maxlength="300">{project?.summary ?? ""}</textarea>

    <label for="repo_url">Source link (optional)</label>
    <input id="repo_url" name="repo_url" type="url" placeholder="https://github.com/you/project" value={project?.repo_url ?? ""} />

    <label for="live_url">Live site link (optional)</label>
    <input id="live_url" name="live_url" type="url" placeholder="https://example.com" value={project?.live_url ?? ""} />

    <label for="cover-input">Cover image</label>
    <input id="cover-input" type="file" accept="image/*" />
    <input name="cover_key" type="hidden" value={project?.cover_key ?? ""} />
    <p class="field-note">Current: <span id="cover-current">{project?.cover_key ?? "none"}</span></p>

    <label for="status">Status</label>
    <select id="status" name="status">
      <option value="draft" selected={project?.status !== "published"}>Draft</option>
      <option value="published" selected={project?.status === "published"}>Published</option>
    </select>
  </EditorShell>
</AdminLayout>
