---
import { env } from "cloudflare:workers";
import AdminLayout from "../../layouts/AdminLayout.astro";
import { listEnquiries } from "../../lib/db.ts";
import { describeSource } from "../../lib/enquiry.ts";

const enquiries = await listEnquiries(env.DB);
const when = (sec: number) => new Date(sec * 1000).toISOString().replace("T", " ").slice(0, 16) + " UTC";
---
<AdminLayout title="Enquiries">
  <h1>Enquiries</h1>
  <p id="message" role="alert" hidden></p>
  {enquiries.length === 0 ? <p class="empty">No messages yet.</p> : (
    <ul class="grid">
      {enquiries.map((e) => (
        <li class="card">
          <p class="meta">{when(e.created_at)} · {e.timeline || "Timing not given"} · Came from: {describeSource(e)}</p>
          <h2><a href={`mailto:${e.email}?subject=${encodeURIComponent("Re: your message to taiatiniyara.com")}`}>{e.email}</a></h2>
          <p class="verbatim">{e.message}</p>
          <div class="actions">
            <button class="btn danger" type="button" data-action="delete-enquiry" data-id={e.id} data-title={`the message from ${e.email}`}>Delete</button>
          </div>
        </li>
      ))}
    </ul>
  )}
</AdminLayout>

<script>
  import "../../admin/dashboard.ts";
</script>
