---
import { env } from "cloudflare:workers";
import Layout from "../../layouts/Layout.astro";
import { listProjects } from "../../lib/db.ts";

const projects = await listProjects(env.DB);
---
<Layout title="Work" description="Projects I've built, with the live site and source where I can share them." hl="lagoon">
  <h1>Work</h1>
  <div class="rule"></div>
  <p class="lede">See what I've built before you decide. Open a project to read how it was made.</p>
  <p>Where I can, I link the live site and the source.</p>
  {projects.length === 0 ? <p class="empty">Nothing here yet. The first project is coming.</p> : (
    <ul class="grid">
      {projects.map((p) => (
        <li class="card">
          {p.cover_key && <img src={`/${p.cover_key}?w=800`} alt="" loading="lazy" width="800" height="400" />}
          <h2><a class="stretch" href={`/projects/${p.slug}`}>{p.title}</a></h2>
          {p.summary && <p>{p.summary}</p>}
        </li>
      ))}
    </ul>
  )}

  <h2>Want something like this?</h2>
  <p>Tell me what you're building and when you need it. <a href="mailto:mail@taiatiniyara.com">mail@taiatiniyara.com</a></p>
</Layout>
