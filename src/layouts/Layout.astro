---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  image?: string;
  hl?: "lagoon" | "sun" | "hibiscus" | "flame" | "violet";
  noindex?: boolean;
  article?: boolean;
  /** Full-bleed page: the page lays out its own .wrap columns. */
  wide?: boolean;
  /** schema.org objects, each rendered as one JSON-LD block. */
  jsonld?: Record<string, unknown>[];
}
const { title, description = "Web apps, mobile apps and APIs that load fast and work for everyone. Tell me what you need.", image, hl = "lagoon", noindex = false, article = false, wide = false, jsonld = [] } = Astro.props;
const site = "https://taiatiniyara.com";
const canonical = new URL(Astro.url.pathname, site).href;
const fullTitle = title === "Taia Tiniyara" ? title : `${title} · Taia Tiniyara`;
// Link previews need a raster image. Our own media is resized to the usual 1200 px card width.
const og = new URL(image?.startsWith("/media/") && !image.endsWith(".gif") ? `${image}?w=1200` : (image ?? "/og.png"), site).href;
const here = Astro.url.pathname;
const nav = [["/projects", "Work"], ["/blog", "Blog"], ["/about", "About"], ["/contact", "Contact"]];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Taia Tiniyara" href="/rss.xml" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:alt" content={image ? title : "The Taia Tiniyara mark in neon green on Dark Blue"} />
    <meta property="og:site_name" content="Taia Tiniyara" />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonld.map((o) => <script is:inline type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", ...o }).replace(/</g, "\\u003c")} />)}
    <script is:inline src="/theme.js"></script>
  </head>
  <body class={`hl-${hl}`}>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <a href="/" aria-label="Taia Tiniyara, home"><img src="/mark.svg" width="96" height="48" alt="" /></a>
      <nav aria-label="Main">
        {nav.map(([href, label]) => <a href={href} aria-current={here === href || here.startsWith(href + "/") ? "page" : undefined}>{label}</a>)}
        <button class="theme-toggle" type="button" id="theme-toggle"><span class="to-light">Light theme</span><span class="to-dark">Dark theme</span></button>
      </nav>
    </header>
    <main id="main" class={wide ? "wide" : undefined}><slot /></main>
    <footer class="site-footer">
      <span>Taia Tiniyara</span>
      <a href="/rss.xml">RSS feed</a>
      <a href="/contact">Contact</a>
      <a href="mailto:mail@taiatiniyara.com">Email me</a>
      <span>No cookies and no analytics. Your theme choice stays in your browser. If you use the contact form, I keep your message only to reply to it.</span>
    </footer>
    <script>
      import "../scripts/copy.ts";
      document.getElementById("theme-toggle")?.addEventListener("click", () => {
        const root = document.documentElement;
        const light = root.dataset.theme ? root.dataset.theme === "light" : matchMedia("(prefers-color-scheme: light)").matches;
        const next = light ? "dark" : "light";
        root.dataset.theme = next;
        try { localStorage.setItem("theme", next); } catch {}
      });
    </script>
  </body>
</html>
