---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  image?: string;
  hl?: "lagoon" | "sun" | "hibiscus" | "flame" | "violet";
  noindex?: boolean;
  article?: boolean;
}
const { title, description = "Web apps, mobile apps and APIs that load fast and work for everyone. Tell me what you need.", image, hl = "lagoon", noindex = false, article = false } = Astro.props;
const site = "https://taiatiniyara.com";
const canonical = new URL(Astro.url.pathname, site).href;
const fullTitle = title === "Taia Tiniyara" ? title : `${title} · Taia Tiniyara`;
const og = new URL(image ?? "/mark.svg", site).href;
const here = Astro.url.pathname;
const nav = [["/projects", "Work"], ["/blog", "Blog"], ["/about", "About"]];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Taia Tiniyara" href="/rss.xml" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta name="twitter:card" content={image ? "summary_large_image" : "summary"} />
    <script is:inline src="/theme.js"></script>
  </head>
  <body class={`hl-${hl}`}>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <a href="/" aria-label="Taia Tiniyara, home"><img src="/mark.svg" width="96" height="48" alt="" /></a>
      <nav aria-label="Main">
        {nav.map(([href, label]) => <a href={href} aria-current={here === href || here.startsWith(href + "/") ? "page" : undefined}>{label}</a>)}
        <button class="btn" type="button" id="theme-toggle">Theme</button>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <span>Taia Tiniyara</span>
      <a href="/rss.xml">RSS</a>
      <a href="mailto:mail@taiatiniyara.com">Email</a>
    </footer>
    <script>
      document.getElementById("theme-toggle")?.addEventListener("click", () => {
        const root = document.documentElement;
        const light = root.dataset.theme ? root.dataset.theme === "light" : matchMedia("(prefers-color-scheme: light)").matches;
        const next = light ? "dark" : "light";
        root.dataset.theme = next;
        try { localStorage.setItem("theme", next); } catch {}
      });
    </script>
  </body>
</html>
