---
import { postPath, type PostRow } from "../lib/db.ts";
import { fmtDate } from "../lib/format.ts";

interface Props { posts: PostRow[]; showProject?: boolean; level?: "h2" | "h3" }
const { posts, showProject = true, level: Heading = "h3" } = Astro.props;
---
{posts.length === 0 ? <p class="empty">Nothing here yet.</p> : (
  <ul class="rows">
    {posts.map((p) => (
      <li class="row post">
        <p class="meta"><time datetime={fmtDate(p.published_at)}>{fmtDate(p.published_at)}</time>{showProject && p.project_title && <><br />{p.project_title}</>}</p>
        <Heading><a class="stretch" href={postPath(p)}>{p.title}</a></Heading>
        {p.summary && <p>{p.summary}</p>}
      </li>
    ))}
  </ul>
)}
