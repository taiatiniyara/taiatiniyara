---
import type { Project, PostRow } from "../lib/db.ts";
import PostList from "./PostList.astro";
import CtaCard from "./CtaCard.astro";
import { IMAGE_WIDTHS } from "../lib/url.ts";

interface Props { project: Project; html: string; posts: PostRow[] }
const { project, html, posts } = Astro.props;
const cover = project.cover_key ? `/${project.cover_key}` : null;
const srcset = cover && !cover.endsWith(".gif") ? IMAGE_WIDTHS.map((w) => `${cover}?w=${w} ${w}w`).join(", ") : undefined;
---
<article>
  <h1>{project.title}</h1>
  {project.summary && <p class="lede">{project.summary}</p>}
  {project.result && <p class="result"><strong>Result:</strong> {project.result}</p>}
  {(project.repo_url || project.live_url) && (
    <div class="actions">
      {project.live_url && <a class="btn primary" href={project.live_url} target="_blank" rel="noopener">Live site</a>}
      {project.repo_url && <a class="btn" href={project.repo_url} target="_blank" rel="noopener">Source</a>}
    </div>
  )}
  {cover && <img class="cover" src={`${cover}?w=1200`} srcset={srcset} sizes="(min-width: 64rem) 61rem, 100vw" alt="" width="1200" height="600" decoding="async" />}
  <div class="prose" set:html={html} />
  <CtaCard source={`project:${project.slug}`} heading="Want something like this?" />
  <h2>Posts</h2>
  <PostList posts={posts} showProject={false} />
</article>
